<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= data.name || 'Resume' %></title>
  <%
    const tplId = data.templateId || 'classic';
    const isModern    = tplId === 'modern';
    const isExecutive = tplId === 'executive';
    const isMinimal   = tplId === 'minimal';
    const isLinkedin  = tplId === 'linkedin';
    const isImpact    = tplId === 'impact';
    const normalizeUrl = (value) => {
      const raw = typeof value === 'string' ? value.trim() : '';
      if (!raw) return '';
      return /^https?:\/\//i.test(raw) ? raw : `https://${raw}`;
    };
    const formatUrlLabel = (value) => {
      const raw = typeof value === 'string' ? value.trim() : '';
      return raw.replace(/^https?:\/\//i, '').replace(/\/$/, '');
    };
    // contact separator per template
    const sep = isMinimal ? ' \u00B7 ' : ' | ';
  %>
  <style>
    /* ── Reset ──────────────────────────────────────────── */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    /* ── Base ───────────────────────────────────────────── */
    body {
      font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
      font-size: 10.5pt;
      line-height: 1.55;
      color: #1a1a2e;
      background: #ffffff;
    }
    .resume {
      max-width: 760px;
      margin: 0 auto;
      padding: 24px 32px;
    }

    /* ── Header ─────────────────────────────────────────── */
    .resume-header {
      text-align: center;
      border-bottom: 2px solid #1a3c6e;
      padding-bottom: 14px;
      margin-bottom: 18px;
    }
    .r-name {
      font-size: 22pt; font-weight: 700;
      color: #1a3c6e; letter-spacing: 2px;
      text-transform: uppercase;
    }
    .r-title  { font-size: 11.5pt; color: #4a5568; margin-top: 3px; }
    .r-contact { font-size: 9.5pt; color: #555; margin-top: 6px; }
    .r-sep { color: #aaa; margin: 0 6px; }
    .r-link { color: #0a66c2; text-decoration: none; font-weight: 600; }
    .r-link-pill {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 999px;
      border: 1px solid #0a66c2;
      background: #eef6ff;
      text-decoration: none;
    }

    /* ── Sections ───────────────────────────────────────── */
    .section { margin-bottom: 15px; }
    .section:last-child { margin-bottom: 0; }
    .section-heading {
      font-size: 10.5pt; font-weight: 700;
      color: #1a3c6e; text-transform: uppercase;
      letter-spacing: 1.2px;
      border-bottom: 1.5px solid #1a3c6e;
      padding-bottom: 2px; margin-bottom: 9px;
    }

    /* ── Summary ────────────────────────────────────────── */
    .summary-text { font-size: 10.5pt; line-height: 1.65; color: #2d3748; }

    /* ── Skills ─────────────────────────────────────────── */
    .skill-row { font-size: 10.5pt; color: #2d3748; line-height: 1.85; }
    .skill-label { font-weight: 700; color: #1a1a2e; }

    /* ── Entry ───────────────────────────────────────────── */
    .entry { margin-bottom: 12px; }
    .entry:last-child { margin-bottom: 0; }
    .entry-top {
      display: flex; justify-content: space-between;
      align-items: flex-start; gap: 8px;
    }
    .entry-left { flex: 1; }
    .entry-role     { font-size: 11pt; font-weight: 700; color: #1a1a2e; }
    .entry-company  { font-size: 10.5pt; color: #4a5568; font-style: italic; }
    .entry-duration { font-size: 9.5pt; color: #718096; white-space: nowrap; padding-top: 2px; }
    .bullets { margin-top: 5px; padding-left: 18px; }
    .bullets li { font-size: 10.5pt; color: #2d3748; margin-bottom: 2px; line-height: 1.55; }

    /* ── Education ───────────────────────────────────────── */
    .edu-entry { margin-bottom: 10px; }
    .edu-entry:last-child { margin-bottom: 0; }
    .edu-top { display: flex; justify-content: space-between; align-items: flex-start; }
    .edu-degree { font-size: 11pt; font-weight: 700; color: #1a1a2e; }
    .edu-school { font-size: 10.5pt; color: #4a5568; font-style: italic; }
    .edu-meta   { font-size: 9.5pt; color: #718096; margin-top: 1px; }
    .edu-year   { font-size: 9.5pt; color: #718096; white-space: nowrap; }

    /* ════════════════════════════════════════════════════════
       TEMPLATE OVERRIDES
       ════════════════════════════════════════════════════════ */

    <% if (isModern) { %>
    /* ── MODERN (teal, left-aligned) ──────────────────────── */
    .resume-header {
      text-align: left;
      border-bottom: 2px solid #0d9488;
    }
    .r-name {
      font-size: 26pt; font-weight: 800;
      color: #0f172a; letter-spacing: -0.5px;
      text-transform: none;
    }
    .r-title  { color: #0d9488; font-weight: 600; font-size: 12pt; }
    .r-contact { color: #475569; }
    .r-sep  { color: #94a3b8; }
    .section-heading {
      color: #0d9488;
      border-bottom: none;
      border-left: 3px solid #0d9488;
      padding-left: 8px; padding-bottom: 0;
      line-height: 1.4;
    }
    .entry-role { color: #0f172a; }
    .skill-label { color: #0f172a; }
    <% } %>

    <% if (isExecutive) { %>
    /* ── EXECUTIVE (dark header, blue accent) ─────────────── */
    .resume-header {
      background: #0f172a;
      margin: -24px -32px 20px -32px;
      padding: 24px 32px;
      border-bottom: none;
      text-align: center;
    }
    .r-name {
      font-size: 23pt; font-weight: 700;
      color: #f8fafc; letter-spacing: 2px;
      text-transform: uppercase;
    }
    .r-title   { color: #94a3b8; font-size: 11pt; }
    .r-contact { color: #94a3b8; }
    .r-sep     { color: #334155; }
    .section-heading {
      color: #1d4ed8;
      border-bottom: none;
      border-left: 3px solid #1d4ed8;
      padding-left: 8px; padding-bottom: 0;
      line-height: 1.4;
    }
    .entry-role { color: #1e293b; }
    .edu-degree { color: #1e293b; }
    <% } %>

    <% if (isMinimal) { %>
    /* ── MINIMAL (clean, understated) ─────────────────────── */
    .resume-header {
      text-align: left;
      border-bottom: 1px solid #e5e7eb;
      padding-bottom: 12px;
    }
    .r-name {
      font-size: 22pt; font-weight: 300;
      color: #374151; letter-spacing: 0.5px;
      text-transform: none;
    }
    .r-title   { font-size: 11pt; color: #6b7280; font-weight: 400; }
    .r-contact { color: #9ca3af; font-size: 9pt; }
    .r-sep     { color: #d1d5db; margin: 0 4px; }
    .section-heading {
      font-size: 9pt; font-weight: 600;
      color: #6b7280; letter-spacing: 2.5px;
      border-bottom: 1px solid #e5e7eb;
      padding-bottom: 3px;
    }
    .entry-role    { font-weight: 600; color: #374151; font-size: 10.5pt; }
    .entry-company { font-style: normal; color: #6b7280; }
    .entry-duration { color: #9ca3af; }
    .bullets li  { color: #4b5563; }
    .skill-label { color: #374151; font-weight: 600; }
    .skill-row   { color: #4b5563; }
    .edu-degree  { font-weight: 600; color: #374151; font-size: 10.5pt; }
    .edu-school  { font-style: normal; color: #6b7280; }
    .edu-year    { color: #9ca3af; }
    <% } %>

    <% if (isLinkedin) { %>
    /* ── LINKEDIN (profile-inspired) ───────────────────────── */
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .resume-header {
      text-align: left;
      border-bottom: 1px solid #d6deea;
      margin: -24px -32px 18px -32px;
      padding: 18px 32px 14px;
      background: linear-gradient(180deg, #e8f3ff 0, #ffffff 100%);
    }
    .r-name {
      font-size: 24pt;
      font-weight: 700;
      color: #172330;
      letter-spacing: 0;
      text-transform: none;
    }
    .r-title {
      margin-top: 6px;
      font-size: 11.5pt;
      color: #425466;
      font-weight: 600;
    }
    .r-contact { color: #5f6f82; font-size: 9pt; }
    .r-sep { color: #a0aec0; margin: 0 4px; }
    .section {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 10px 12px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    }
    .section-heading {
      color: #0a66c2;
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 8px;
      letter-spacing: 0;
      text-transform: none;
      font-size: 11pt;
    }
    .entry-role,
    .edu-degree,
    .skill-label { color: #1f2d3d; }
    .entry-company,
    .edu-school { color: #526274; font-style: normal; }
    .entry-duration,
    .edu-year { font-size: 9pt; }
    <% } %>

    <% if (isImpact) { %>
    /* ── IMPACT (two-column, achievement-first) ───────────── */
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #ffffff;
      color: #333;
    }
    .resume {
      background: #ffffff;
      max-width: 860px;
      padding: 22px 24px;
    }
    .resume-header {
      text-align: left;
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 12px;
    }
    .r-name {
      font-size: 34pt;
      font-weight: 800;
      line-height: 1.08;
      color: #111827;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .r-title {
      margin-top: 5px;
      font-size: 15pt;
      font-weight: 700;
      color: #0a66c2;
    }
    .r-contact {
      margin-top: 7px;
      color: #48515d;
      font-size: 9.5pt;
    }
    .r-sep { color: #99a1ac; margin: 0 5px; }
    .impact-layout {
      display: table;
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
    }
    .impact-left,
    .impact-right {
      display: table-cell;
      vertical-align: top;
    }
    .impact-left {
      width: 60%;
      padding-right: 18px;
    }
    .impact-right {
      width: 40%;
      padding-left: 12px;
    }
    .impact-section {
      margin-bottom: 12px;
    }
    .impact-title {
      color: #111827;
      font-size: 15pt;
      font-weight: 800;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      border-bottom: 2px solid #111827;
      margin-bottom: 7px;
      line-height: 1.15;
    }
    .summary-text {
      color: #4b5563;
      font-size: 11pt;
      line-height: 1.42;
    }
    .entry,
    .edu-entry {
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px dashed #cfd3da;
    }
    .entry:last-child,
    .edu-entry:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }
    .entry-role {
      font-size: 14pt;
      font-weight: 800;
      color: #111827;
      line-height: 1.2;
    }
    .entry-company,
    .edu-school {
      color: #0a66c2;
      font-style: normal;
      font-weight: 700;
      font-size: 10.5pt;
    }
    .entry-duration,
    .edu-year,
    .edu-meta {
      color: #5f6773;
      font-size: 9.5pt;
    }
    .bullets { margin-top: 4px; padding-left: 18px; }
    .bullets li {
      color: #4b5563;
      font-size: 10.5pt;
      line-height: 1.35;
      margin-bottom: 2px;
    }
    .impact-ach {
      border-bottom: 1px dashed #cfd3da;
      margin-bottom: 9px;
      padding-bottom: 8px;
    }
    .impact-ach:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }
    .impact-ach-title {
      font-size: 12.5pt;
      font-weight: 800;
      color: #111827;
      line-height: 1.2;
    }
    .impact-ach-text {
      color: #4b5563;
      font-size: 10.5pt;
      line-height: 1.35;
      margin-top: 2px;
    }
    .impact-skill-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .impact-skill {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 999px;
      border: 1px solid #d3d8e2;
      background: #fafafa;
      color: #2f3742;
      font-size: 9.5pt;
      font-weight: 700;
      line-height: 1;
    }
    <% } %>
  </style>
</head>
<body>
<div class="resume">

  <!-- HEADER -->
  <div class="resume-header">
    <% if (data.name && data.name.trim()) { %>
      <div class="r-name"><%= data.name.trim() %></div>
    <% } %>
    <% if (data.title && data.title.trim()) { %>
      <div class="r-title"><%= data.title.trim() %></div>
    <% } %>
    <%
      const contactItems = [];
      if (data.email    && data.email.trim())    contactItems.push({ type: 'text', value: data.email.trim() });
      if (data.phone    && data.phone.trim())    contactItems.push({ type: 'text', value: data.phone.trim() });
      if (data.location && data.location.trim()) contactItems.push({ type: 'text', value: data.location.trim() });
      const linkedinUrl = normalizeUrl(data.linkedin);
      if (linkedinUrl) contactItems.push({ type: 'link', value: 'LinkedIn', href: linkedinUrl });
      const websiteUrl = normalizeUrl(data.website);
      if (websiteUrl) contactItems.push({ type: 'link', value: 'Portfolio', href: websiteUrl, pill: true });
    %>
    <% if (contactItems.length > 0) { %>
      <div class="r-contact">
        <% contactItems.forEach((item, idx) => { %>
          <% if (item.type === 'link') { %>
            <a class="r-link<%= item.pill ? ' r-link-pill' : '' %>" href="<%= item.href %>" target="_blank" rel="noopener"><%= item.value %></a>
          <% } else { %>
            <%= item.value %>
          <% } %>
          <% if (idx < contactItems.length - 1) { %><span class="r-sep"><%= sep %></span><% } %>
        <% }) %>
      </div>
    <% } %>
  </div>

  <% if (isImpact) { %>
  <%
    const expsImpact = (data.experience || []).filter(e => e.company || e.role || e.responsibilities);
    const projsImpact = (data.projects || []).filter(p => p.name || p.description);
    const edusImpact = (data.education || []).filter(e => e.degree || e.school);
    const firstMeaningfulLine = (text) => {
      if (typeof text !== 'string' || !text.trim()) return '';
      const line = text.replace(/\r\n/g, '\n')
        .split('\n')
        .map(item => item.trim().replace(/^[-*]+\s*/, ''))
        .find(Boolean);
      return line || '';
    };

    const impactHighlights = [];
    projsImpact.forEach((proj) => {
      if (impactHighlights.length >= 3) return;
      const title = (proj.name || '').trim();
      const detail = firstMeaningfulLine(proj.description || proj.tech || '');
      if (title || detail) {
        impactHighlights.push({
          title: title || 'Project Outcome',
          text: detail || 'Delivered measurable business value through engineering improvements.'
        });
      }
    });

    if (!impactHighlights.length) {
      expsImpact.forEach((exp) => {
        if (impactHighlights.length >= 3) return;
        const title = (exp.role || exp.company || '').trim();
        const detail = firstMeaningfulLine(exp.responsibilities || '');
        if (title || detail) {
          impactHighlights.push({
            title: title || 'Delivery Highlight',
            text: detail || 'Contributed to core backend and platform delivery improvements.'
          });
        }
      });
    }

    const impactSkillTokensRaw = (typeof data.skills === 'string' ? data.skills : (data.skills || []).join('\n'))
      .split('\n')
      .map(line => line.trim())
      .filter(Boolean)
      .flatMap((line) => {
        const colon = line.indexOf(':');
        const items = colon >= 0 ? line.substring(colon + 1) : line;
        return items.split(',').map(item => item.trim()).filter(Boolean);
      });

    const impactSkillSeen = new Set();
    const impactSkills = impactSkillTokensRaw.filter((skill) => {
      const key = skill.toLowerCase();
      if (impactSkillSeen.has(key)) return false;
      impactSkillSeen.add(key);
      return true;
    }).slice(0, 28);
  %>

  <div class="impact-layout">
    <div class="impact-left">
      <% if (data.summary && data.summary.trim()) { %>
      <div class="impact-section">
        <div class="impact-title">Summary</div>
        <p class="summary-text"><%= data.summary.trim() %></p>
      </div>
      <% } %>

      <% if (expsImpact.length > 0) { %>
      <div class="impact-section">
        <div class="impact-title">Experience</div>
        <% expsImpact.forEach(exp => { %>
          <div class="entry">
            <div class="entry-top">
              <div class="entry-left">
                <% if (exp.role) { %><div class="entry-role"><%= exp.role %></div><% } %>
                <% if (exp.company) { %><div class="entry-company"><%= exp.company %></div><% } %>
              </div>
              <% if (exp.duration && exp.duration.trim()) { %><div class="entry-duration"><%= exp.duration.trim() %></div><% } %>
            </div>
            <% if (exp.responsibilities && exp.responsibilities.trim()) { %>
              <ul class="bullets">
                <% exp.responsibilities.split('\n').forEach(line => {
                     const t = line.trim().replace(/^[-*]+\s*/, '');
                     if (t) { %><li><%= t %></li><% } }); %>
              </ul>
            <% } %>
          </div>
        <% }); %>
      </div>
      <% } %>

      <% if (edusImpact.length > 0) { %>
      <div class="impact-section">
        <div class="impact-title">Education</div>
        <% edusImpact.forEach(edu => { %>
          <div class="edu-entry">
            <div class="edu-top">
              <div>
                <div class="edu-degree">
                  <%= edu.degree || '' %><% if (edu.field && edu.field.trim()) { %> in <%= edu.field.trim() %><% } %>
                </div>
                <% if (edu.school && edu.school.trim()) { %><div class="edu-school"><%= edu.school.trim() %></div><% } %>
                <% if (edu.gpa && edu.gpa.trim()) { %><div class="edu-meta">GPA: <%= edu.gpa.trim() %></div><% } %>
              </div>
              <% if (edu.year && edu.year.trim()) { %><div class="edu-year"><%= edu.year.trim() %></div><% } %>
            </div>
          </div>
        <% }); %>
      </div>
      <% } %>
    </div>

    <div class="impact-right">
      <% if (impactHighlights.length > 0) { %>
      <div class="impact-section">
        <div class="impact-title">Key Achievements</div>
        <% impactHighlights.forEach(item => { %>
          <div class="impact-ach">
            <div class="impact-ach-title"><%= item.title %></div>
            <p class="impact-ach-text"><%= item.text %></p>
          </div>
        <% }); %>
      </div>
      <% } %>

      <% if (impactSkills.length > 0) { %>
      <div class="impact-section">
        <div class="impact-title">Skills</div>
        <div class="impact-skill-grid">
          <% impactSkills.forEach(skill => { %><span class="impact-skill"><%= skill %></span><% }) %>
        </div>
      </div>
      <% } %>

      <% if (projsImpact.length > 0) { %>
      <div class="impact-section">
        <div class="impact-title">Projects</div>
        <% projsImpact.forEach(proj => { %>
          <div class="entry">
            <div class="entry-top">
              <div class="entry-left">
                <% if (proj.name) { %><div class="entry-role"><%= proj.name %></div><% } %>
                <% if (proj.link && proj.link.trim()) { %>
                  <% const projectUrl = normalizeUrl(proj.link); %>
                  <div class="entry-company"><a class="r-link" href="<%= projectUrl %>" target="_blank" rel="noopener"><%= formatUrlLabel(proj.link) %></a></div>
                <% } else if (proj.tech && proj.tech.trim()) { %>
                  <div class="entry-company"><%= proj.tech.trim() %></div>
                <% } %>
              </div>
              <% if (proj.duration && proj.duration.trim()) { %><div class="entry-duration"><%= proj.duration.trim() %></div><% } %>
            </div>
            <% if (proj.description && proj.description.trim()) { %>
              <ul class="bullets">
                <% proj.description.split('\n').forEach(line => {
                     const t = line.trim().replace(/^[-*]+\s*/, '');
                     if (t) { %><li><%= t %></li><% } }); %>
              </ul>
            <% } %>
          </div>
        <% }); %>
      </div>
      <% } %>
    </div>
  </div>

  <% } else { %>
  <!-- SUMMARY -->
  <% if (data.summary && data.summary.trim()) { %>
  <div class="section">
    <div class="section-heading">Professional Summary</div>
    <p class="summary-text"><%= data.summary.trim() %></p>
  </div>
  <% } %>

  <!-- SKILLS -->
  <%
    const skillLines = (typeof data.skills === 'string' ? data.skills : (data.skills || []).join('\n'))
      .split('\n').map(l => l.trim()).filter(Boolean);
  %>
  <% if (skillLines.length > 0) { %>
  <div class="section">
    <div class="section-heading">Technical Skills</div>
    <div class="skills-cat">
      <% skillLines.forEach(line => {
           const colon = line.indexOf(':');
           if (colon > 0) {
             const cat   = line.substring(0, colon).trim();
             const items = line.substring(colon + 1).trim(); %>
        <div class="skill-row"><span class="skill-label"><%= cat %>:</span>  <%= items %></div>
      <%   } else { %>
        <div class="skill-row"><%= line %></div>
      <%   } }); %>
    </div>
  </div>
  <% } %>

  <!-- EXPERIENCE -->
  <% const exps = (data.experience || []).filter(e => e.company || e.role); %>
  <% if (exps.length > 0) { %>
  <div class="section">
    <div class="section-heading">Experience</div>
    <% exps.forEach(exp => { %>
      <div class="entry">
        <div class="entry-top">
          <div class="entry-left">
            <% if (exp.role)    { %><div class="entry-role"><%= exp.role %></div><% } %>
            <% if (exp.company) { %><div class="entry-company"><%= exp.company %></div><% } %>
          </div>
          <% if (exp.duration && exp.duration.trim()) { %>
            <div class="entry-duration"><%= exp.duration.trim() %></div>
          <% } %>
        </div>
        <% if (exp.responsibilities && exp.responsibilities.trim()) { %>
          <ul class="bullets">
            <% exp.responsibilities.split('\n').forEach(line => {
                 const t = line.trim().replace(/^[•▪\-\*]+\s*/, '');
                 if (t) { %><li><%= t %></li><% } }); %>
          </ul>
        <% } %>
      </div>
    <% }); %>
  </div>
  <% } %>

  <!-- PROJECTS -->
  <% const projs = (data.projects || []).filter(p => p.name || p.description); %>
  <% if (projs.length > 0) { %>
  <div class="section">
    <div class="section-heading">Projects</div>
    <% projs.forEach(proj => { %>
      <div class="entry">
        <div class="entry-top">
          <div class="entry-left">
            <div class="entry-role">
              <%= proj.name || '' %>
              <% if (proj.tech && proj.tech.trim()) { %><span style="font-weight:400;font-size:10pt;color:#718096;"> — <%= proj.tech.trim() %></span><% } %>
            </div>
            <% if (proj.link && proj.link.trim()) { %>
              <% const projectUrl = normalizeUrl(proj.link); %>
              <div class="entry-company"><a class="r-link" href="<%= projectUrl %>" target="_blank" rel="noopener"><%= formatUrlLabel(proj.link) %></a></div>
            <% } %>
          </div>
          <% if (proj.duration && proj.duration.trim()) { %><div class="entry-duration"><%= proj.duration.trim() %></div><% } %>
        </div>
        <% if (proj.description && proj.description.trim()) { %>
          <ul class="bullets">
            <% proj.description.split('\n').forEach(line => {
                 const t = line.trim().replace(/^[•▪\-\*]+\s*/, '');
                 if (t) { %><li><%= t %></li><% } }); %>
          </ul>
        <% } %>
      </div>
    <% }); %>
  </div>
  <% } %>

  <!-- EDUCATION -->
  <% const edus = (data.education || []).filter(e => e.degree || e.school); %>
  <% if (edus.length > 0) { %>
  <div class="section">
    <div class="section-heading">Education</div>
    <% edus.forEach(edu => { %>
      <div class="edu-entry">
        <div class="edu-top">
          <div>
            <div class="edu-degree">
              <%= edu.degree || '' %><% if (edu.field && edu.field.trim()) { %> in <%= edu.field.trim() %><% } %>
            </div>
            <% if (edu.school && edu.school.trim()) { %><div class="edu-school"><%= edu.school.trim() %></div><% } %>
            <% if (edu.gpa    && edu.gpa.trim())    { %><div class="edu-meta">GPA: <%= edu.gpa.trim() %></div><% } %>
          </div>
          <% if (edu.year && edu.year.trim()) { %><div class="edu-year"><%= edu.year.trim() %></div><% } %>
        </div>
      </div>
    <% }); %>
  </div>
  <% } %>

  <% } %>
</div>
</body>
</html>

